@model SIGCAP_TSC.Models.Eventos.EventoParticipantesViewModel
@{
    ViewData["Title"] = "Reporte de Participantes";
    var estados = Model.EstadosList;
    string GetNombreEstado(int? id) => estados?.FirstOrDefault(e => e.Id == id)?.Nombre ?? "DESCONOCIDO";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex justify-between items-center flex-wrap gap-3">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
                <i data-lucide="clipboard-list" class="h-7 w-7 text-indigo-600"></i>
                Reporte de Participantes
            </h1>
            <p class="text-gray-500 text-sm mt-1">Listado de inscritos en el evento</p>
        </div>
        <div class="flex gap-2">
            <button onclick="guardarTodasLasNotas()" id="btnGuardarTodas"
               class="flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition shadow-sm text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                <i data-lucide="save" class="h-4 w-4"></i> Guardar Todas las Notas
            </button>
            <a href="@Url.Action("ExportarParticipantesCsv", new { id = Model.Evento.id_evento })" 
               class="flex items-center gap-2 bg-emerald-600 text-white px-4 py-2 rounded-lg hover:bg-emerald-700 transition shadow-sm text-sm font-medium">
                <i data-lucide="download" class="h-4 w-4"></i> Exportar CSV
            </a>
            <a href="@Url.Action("ExportarAsistenciaExcel", new { id = Model.Evento.id_evento })" 
               class="flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition shadow-sm text-sm font-medium">
                <i data-lucide="file-spreadsheet" class="h-4 w-4"></i> Asistencia Excel
            </a>
            <a href="@Url.Action("ExportarCalificacionesExcel", new { id = Model.Evento.id_evento })" 
               class="flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition shadow-sm text-sm font-medium">
                <i data-lucide="award" class="h-4 w-4"></i> Calificaciones Excel
            </a>
            <button onclick="exportarPDF()" 
               class="flex items-center gap-2 bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 transition shadow-sm text-sm font-medium">
                <i data-lucide="file-text" class="h-4 w-4"></i> Exportar PDF
            </button>
            <a href="@Url.Action("Index")" 
               class="flex items-center gap-2 bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200 transition text-sm font-medium">
                <i data-lucide="arrow-left" class="h-4 w-4"></i> Volver
            </a>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-6 right-6 z-50 hidden transition-all duration-300 transform translate-x-full">
        <div id="toastContent" class="flex items-center gap-3 px-5 py-3.5 rounded-xl shadow-lg border text-sm font-medium">
            <i id="toastIcon" class="h-5 w-5 flex-shrink-0"></i>
            <span id="toastMessage"></span>
        </div>
    </div>

    <!-- Evento Info Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <p class="text-xs text-gray-400 uppercase font-semibold mb-1">Evento</p>
                <p class="text-lg font-bold text-gray-900">@Model.Evento?.nombre_evento</p>
                <p class="text-xs text-gray-400 font-mono uppercase">@Model.Evento?.codigo_evento</p>
            </div>
            <div>
                <p class="text-xs text-gray-400 uppercase font-semibold mb-1">Fechas</p>
                <p class="text-sm text-gray-700">
                    <i data-lucide="calendar" class="inline h-4 w-4 text-indigo-400"></i>
                    @(Model.Evento?.fecha_inicio?.ToShortDateString() ?? "") &rarr; @(Model.Evento?.fecha_fin?.ToShortDateString() ?? "")
                </p>
            </div>
            <div>
                <p class="text-xs text-gray-400 uppercase font-semibold mb-1">Cupo</p>
                <p class="text-sm text-gray-700">
                    <i data-lucide="users" class="inline h-4 w-4 text-indigo-400"></i>
                    <strong>@(Model.Evento?.cupo_actual ?? 0)</strong> / @(Model.Evento?.cupo_maximo ?? 0) inscritos
                </p>
            </div>
        </div>
    </div>

    <!-- Summary -->
    <div class="flex items-center gap-3">
        <div class="bg-indigo-50 text-indigo-700 px-4 py-2 rounded-lg text-sm font-medium flex items-center gap-2">
            <i data-lucide="users" class="h-4 w-4"></i>
            Total participantes: <strong>@Model.Total</strong>
        </div>
    </div>

    <!-- Participants Table -->
    <div class="bg-white shadow-lg rounded-xl border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-500">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-4 font-semibold">No.</th>
                        <th class="px-6 py-4 font-semibold">Identificación</th>
                        <th class="px-6 py-4 font-semibold">Nombre Completo</th>
                        <th class="px-6 py-4 font-semibold">Email</th>
                        <th class="px-6 py-4 font-semibold">Fecha Inscripción</th>
                        <th class="px-6 py-4 font-semibold">Estado</th>
                        <th class="px-6 py-4 font-semibold text-center" style="min-width: 200px;">Nota Final</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @if (Model.Participantes != null && Model.Participantes.Any())
                    {
                        int idx = 1;
                        foreach (var p in Model.Participantes)
                        {
                            string estadoColor = p.codigo_estado switch
                            {
                                "INS" => "bg-blue-100 text-blue-700",
                                "APR" => "bg-green-100 text-green-700",
                                "REP" => "bg-red-100 text-red-700",
                                "CAN" => "bg-gray-100 text-gray-600",
                                _ => "bg-gray-100 text-gray-600"
                            };

                            <tr class="hover:bg-gray-50/50 transition-colors" data-inscripcion-id="@p.id_inscripcion">
                                <td class="px-6 py-4 font-medium text-gray-500">@idx</td>
                                <td class="px-6 py-4">
                                    <span class="font-mono text-gray-700">@p.identificacion</span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="font-medium text-gray-900">@p.nombre_participante</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-gray-600">@p.email</span>
                                </td>
                                <td class="px-6 py-4">
                                    @(p.fecha_inscripcion?.ToString("dd/MM/yyyy") ?? "-")
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium @estadoColor">
                                        @p.estado_inscripcion
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-2 justify-center">
                                        <input type="number" 
                                               step="0.01" min="0" max="10"
                                               class="nota-input w-20 px-2.5 py-1.5 text-sm text-center rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all"
                                               value="@(p.nota_final?.ToString("F2") ?? "")"
                                               data-original="@(p.nota_final?.ToString("F2") ?? "")"
                                               data-inscripcion-id="@p.id_inscripcion"
                                               data-estado-id="@(p.codigo_estado == "INS" ? 1 : p.codigo_estado == "APR" ? 2 : p.codigo_estado == "REP" ? 3 : p.codigo_estado == "CAN" ? 4 : 1)"
                                               placeholder="—"
                                               onchange="marcarModificado(this)" />
                                        <button onclick="guardarNotaIndividual(this)" 
                                                class="btn-guardar-nota hidden p-1.5 text-indigo-600 hover:text-white hover:bg-indigo-600 bg-indigo-50 rounded-lg transition-all" 
                                                title="Guardar nota"
                                                data-inscripcion-id="@p.id_inscripcion">
                                            <i data-lucide="check" class="h-4 w-4"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            idx++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-gray-500">
                                <div class="flex flex-col items-center justify-center">
                                    <div class="bg-gray-50 p-3 rounded-full mb-3">
                                        <i data-lucide="inbox" class="h-6 w-6 text-gray-400"></i>
                                    </div>
                                    <p class="text-sm font-medium">No hay participantes inscritos en este evento.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

<script>
    // Export to PDF
    function exportarPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF('p', 'pt', 'a4');
        
        const eventName = "@Model.Evento?.nombre_evento";
        const eventCode = "@Model.Evento?.codigo_evento";
        const fecha = "@DateTime.Now.ToString("dd/MM/yyyy HH:mm")";

        // Title and Header
        doc.setFontSize(18);
        doc.setTextColor(40);
        doc.text("Reporte de Participantes", 40, 50);
        
        doc.setFontSize(11);
        doc.setTextColor(100);
        doc.text(`Evento: ${eventName} (${eventCode})`, 40, 70);
        doc.text(`Fecha de generación: ${fecha}`, 40, 85);
        
        // Horizontal Line
        doc.setDrawColor(220);
        doc.line(40, 100, 555, 100);

        // Table logic
        const table = document.querySelector("table");
        
        doc.autoTable({
            html: table,
            startY: 120,
            theme: 'grid',
            headStyles: { 
                fillColor: [79, 70, 229], // Indigo-600
                textColor: 255,
                fontSize: 10,
                halign: 'center'
            },
            columnStyles: {
                0: { cellWidth: 30, halign: 'center' }, // No.
                5: { halign: 'center' }, // Estado
                6: { halign: 'center' }  // Nota
            },
            didParseCell: function(data) {
                // Remove buttons from the PDF column
                if (data.column.index === 6 && data.section === 'body') {
                    const input = data.cell.raw.querySelector('input');
                    data.cell.text = input ? input.value || '-' : '-';
                }
                // Clean status column
                if (data.column.index === 5 && data.section === 'body') {
                    data.cell.text = data.cell.text[0].trim();
                }
            },
            margin: { top: 120, left: 40, right: 40, bottom: 40 },
            styles: { fontSize: 9, cellPadding: 5 }
        });

        // Footer
        const pageCount = doc.internal.getNumberOfPages();
        for(let i = 1; i <= pageCount; i++) {
            doc.setPage(i);
            doc.setFontSize(8);
            doc.setTextColor(150);
            doc.text(`Página ${i} de ${pageCount}`, doc.internal.pageSize.width - 80, doc.internal.pageSize.height - 20);
        }

        doc.save(`Reporte_Participantes_${eventCode}.pdf`);
    }

    // Track modified inputs
    function marcarModificado(input) {
        const original = input.dataset.original;
        const current = input.value;
        const btnGuardar = input.parentElement.querySelector('.btn-guardar-nota');
        
        if (current !== original) {
            input.classList.add('ring-2', 'ring-amber-400', 'border-amber-400');
            input.classList.remove('border-gray-300');
            btnGuardar.classList.remove('hidden');
        } else {
            input.classList.remove('ring-2', 'ring-amber-400', 'border-amber-400');
            input.classList.add('border-gray-300');
            btnGuardar.classList.add('hidden');
        }

        // Enable/disable bulk save button
        const hayModificados = document.querySelectorAll('.nota-input.ring-amber-400').length > 0;
        document.getElementById('btnGuardarTodas').disabled = !hayModificados;
    }

    // Save single note
    async function guardarNotaIndividual(button) {
        const inscripcionId = button.dataset.inscripcionId;
        const input = button.parentElement.querySelector('.nota-input');
        const notaFinal = input.value !== '' ? parseFloat(input.value) : null;
        const estadoId = parseInt(input.dataset.estadoId);

        button.disabled = true;
        button.innerHTML = '<svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';

        try {
            const response = await fetch('@Url.Action("GuardarNota", "Eventos")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id_inscripcion: parseInt(inscripcionId),
                    nota_final: notaFinal,
                    id_estado_inscripcion: estadoId
                })
            });

            const data = await response.json();

            if (data.success) {
                input.dataset.original = input.value;
                input.classList.remove('ring-2', 'ring-amber-400', 'border-amber-400');
                input.classList.add('border-gray-300', 'ring-2', 'ring-green-400', 'border-green-400');
                button.classList.add('hidden');
                
                showToast('Nota guardada correctamente', 'success');

                setTimeout(() => {
                    input.classList.remove('ring-2', 'ring-green-400', 'border-green-400');
                    input.classList.add('border-gray-300');
                }, 2000);

                const hayModificados = document.querySelectorAll('.nota-input.ring-amber-400').length > 0;
                document.getElementById('btnGuardarTodas').disabled = !hayModificados;
            } else {
                showToast(data.message || 'Error al guardar la nota', 'error');
            }
        } catch (error) {
            showToast('Error de conexión al guardar la nota', 'error');
        }

        button.disabled = false;
        button.innerHTML = '<i data-lucide="check" class="h-4 w-4"></i>';
        lucide.createIcons();
    }

    // Save all modified notes
    async function guardarTodasLasNotas() {
        const modificados = document.querySelectorAll('.nota-input.ring-amber-400');
        if (modificados.length === 0) return;

        const btn = document.getElementById('btnGuardarTodas');
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Guardando...';

        const notas = [];
        modificados.forEach(input => {
            notas.push({
                id_inscripcion: parseInt(input.dataset.inscripcionId),
                nota_final: input.value !== '' ? parseFloat(input.value) : null,
                id_estado_inscripcion: parseInt(input.dataset.estadoId)
            });
        });

        try {
            const response = await fetch('@Url.Action("GuardarNotasMasivas", "Eventos")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(notas)
            });

            const data = await response.json();

            if (data.success) {
                modificados.forEach(input => {
                    input.dataset.original = input.value;
                    input.classList.remove('ring-2', 'ring-amber-400', 'border-amber-400');
                    input.classList.add('border-gray-300', 'ring-2', 'ring-green-400', 'border-green-400');
                    const btnIndividual = input.parentElement.querySelector('.btn-guardar-nota');
                    if (btnIndividual) btnIndividual.classList.add('hidden');

                    setTimeout(() => {
                        input.classList.remove('ring-2', 'ring-green-400', 'border-green-400');
                        input.classList.add('border-gray-300');
                    }, 2000);
                });

                showToast(data.message, 'success');
            } else {
                showToast(data.message || 'Error al guardar las notas', 'error');
            }
        } catch (error) {
            showToast('Error de conexión al guardar las notas', 'error');
        }

        btn.innerHTML = originalText;
        btn.disabled = true;
        lucide.createIcons();
    }

    // Toast notification helper
    function showToast(message, type) {
        const toast = document.getElementById('toast');
        const content = document.getElementById('toastContent');
        const icon = document.getElementById('toastIcon');
        const msg = document.getElementById('toastMessage');

        msg.textContent = message;

        if (type === 'success') {
            content.className = 'flex items-center gap-3 px-5 py-3.5 rounded-xl shadow-lg border text-sm font-medium bg-green-50 border-green-200 text-green-800';
            icon.setAttribute('data-lucide', 'check-circle');
        } else {
            content.className = 'flex items-center gap-3 px-5 py-3.5 rounded-xl shadow-lg border text-sm font-medium bg-red-50 border-red-200 text-red-800';
            icon.setAttribute('data-lucide', 'alert-circle');
        }

        lucide.createIcons();

        toast.classList.remove('hidden', 'translate-x-full');
        toast.classList.add('translate-x-0');

        setTimeout(() => {
            toast.classList.add('translate-x-full');
            setTimeout(() => toast.classList.add('hidden'), 300);
        }, 3000);
    }
</script>
}
