@model SIGCAP_TSC.Models.Participantes.ParticipanteViewModel
@{
    ViewData["Title"] = (Model.id_persona.HasValue && Model.id_persona > 0) ? "Editar Participante" : "Nuevo Participante";
}

<div class="max-w-4xl mx-auto">
    <div class="mb-6 flex items-center gap-4">
        <a href="@Url.Action("Index", "Participantes")" class="p-2 rounded-xl border border-gray-200 text-gray-500 hover:bg-gray-50 transition-colors">
            <i data-lucide="arrow-left" class="h-5 w-5"></i>
        </a>
        <div>
            <h2 class="text-xl font-bold text-gray-900">@ViewData["Title"]</h2>
            <p class="text-sm text-gray-500 mt-1">Completa la ficha de inscripción del participante para DEFORP.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-100 flex gap-3 text-red-800">
            <i data-lucide="alert-circle" class="h-5 w-5 shrink-0"></i>
            <p class="text-sm">@ViewBag.Error</p>
        </div>
    }

    <!-- Tabs Navigation -->
    <div class="border-b border-gray-200 mb-6">
        <nav class="-mb-px flex space-x-8" aria-label="Tabs">
            <button type="button" id="tab-btn-personal" onclick="switchTab('personal')" class="border-indigo-500 text-indigo-600 whitespace-nowrap py-4 px-1 border-b-2 font-semibold text-sm transition-all focus:outline-none flex items-center gap-2">
                <i data-lucide="user" class="h-4 w-4"></i>
                Información Personal
            </button>
            <button type="button" id="tab-btn-institucional" onclick="switchTab('institucional')" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-semibold text-sm transition-all focus:outline-none flex items-center gap-2">
                <i data-lucide="briefcase" class="h-4 w-4"></i>
                Información Institucional
            </button>
            <button type="button" id="tab-btn-academico" onclick="switchTab('academico')" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-semibold text-sm transition-all focus:outline-none flex items-center gap-2">
                <i data-lucide="graduation-cap" class="h-4 w-4"></i>
                Información Académica
            </button>
        </nav>
    </div>

    <form method="post" action="@Url.Action("Save", "Participantes")" class="bg-white rounded-2xl shadow-sm ring-1 ring-gray-900/5 p-6 lg:p-8">
        <input type="hidden" asp-for="id_persona" />
        <input type="hidden" asp-for="sede_regional" id="sede_regional_hidden" />

        <!-- Tab Content: Personal Info -->
        <div id="tab-content-personal" class="tab-pane space-y-6">
            <div class="grid gap-6 md:grid-cols-2">
                <!-- Identificación -->
                <div>
                    <label asp-for="identificacion" class="block text-sm font-semibold text-gray-700 mb-2">Identificación (DNI)</label>
                    <input asp-for="identificacion" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm" placeholder="Ej. 0801199012345" required maxlength="20" />
                </div>

                <!-- Correo -->
                <div>
                    <label asp-for="email" class="block text-sm font-semibold text-gray-700 mb-2">Correo Electrónico</label>
                    <input asp-for="email" type="email" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm" placeholder="ejemplo@correo.com" required maxlength="150" />
                </div>

                <!-- Nombres -->
                <div>
                    <label asp-for="nombres" class="block text-sm font-semibold text-gray-700 mb-2">Nombres</label>
                    <input asp-for="nombres" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm" placeholder="Ej. Juan Carlos" required maxlength="100" />
                </div>

                <!-- Apellidos -->
                <div>
                    <label asp-for="apellidos" class="block text-sm font-semibold text-gray-700 mb-2">Apellidos</label>
                    <input asp-for="apellidos" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm" placeholder="Ej. Perez Garcia" required maxlength="100" />
                </div>

                <!-- Teléfono -->
                <div>
                    <label asp-for="telefono" class="block text-sm font-semibold text-gray-700 mb-2">Número de Celular</label>
                    <input asp-for="telefono" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm" placeholder="Ej. 9999-9999" maxlength="50" />
                </div>

                <!-- Fecha Nacimiento -->
                <div>
                    <label asp-for="Feha_nacimiento" class="block text-sm font-semibold text-gray-700 mb-2">Fecha de Nacimiento</label>
                    <input asp-for="Feha_nacimiento" type="date" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm" value="@(Model.Feha_nacimiento?.ToString("yyyy-MM-dd"))" />
                </div>

                <!-- Género -->
                <div>
                    <label asp-for="Genero" class="block text-sm font-semibold text-gray-700 mb-2">Género</label>
                    <select asp-for="Genero" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm">
                        <option value="">-- Seleccionar --</option>
                        <option value="F">Femenino</option>
                        <option value="M">Masculino</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Tab Content: Institutional Info -->
        <div id="tab-content-institucional" class="tab-pane space-y-6 hidden">
            <div class="grid gap-6 md:grid-cols-2">
                <!-- Código Empleado -->
                <div>
                    <label asp-for="codigo_empleado" class="block text-sm font-semibold text-gray-700 mb-2">No. Código de Empleado</label>
                    <input asp-for="codigo_empleado" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm" placeholder="Ej. EMP-100" maxlength="25" />
                </div>

                <!-- Tipo Nombramiento -->
                <div>
                    <label asp-for="tipo_nombramiento" class="block text-sm font-semibold text-gray-700 mb-2">Tipo de Nombramiento</label>
                    <select asp-for="tipo_nombramiento" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm">
                        <option value="">-- Seleccionar --</option>
                        <option value="Acuerdo">Acuerdo</option>
                        <option value="Contrato">Contrato</option>
                        <option value="Jornal">Jornal</option>
                        <option value="Interino">Interino</option>
                    </select>
                </div>

                <!-- Fecha Ingreso -->
                <div>
                    <label asp-for="fecha_ingreso" class="block text-sm font-semibold text-gray-700 mb-2">Fecha de Ingreso</label>
                    <input asp-for="fecha_ingreso" type="date" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm" value="@(Model.fecha_ingreso?.ToString("yyyy-MM-dd"))" />
                </div>

                <!-- Cargo -->
                <div>
                    <label asp-for="idCargo" class="block text-sm font-semibold text-gray-700 mb-2">Cargo / Puesto</label>
                    <select asp-for="idCargo" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm">
                        <option value="">-- Seleccionar Cargo --</option>
                        @if (ViewBag.Cargos != null)
                        {
                            foreach (var cargo in (List<SIGCAP_TSC.Models.Catalogos.CargoViewModel>)ViewBag.Cargos)
                            {
                                <option value="@cargo.id_puesto">@cargo.nombre</option>
                            }
                        }
                    </select>
                </div>

                <!-- Dirección Superior -->
                <div>
                    <label asp-for="idDireccion" class="block text-sm font-semibold text-gray-700 mb-2">Gerencia o Dirección Superior</label>
                    <select asp-for="idDireccion" id="direccion_select" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm">
                        <option value="">-- Seleccionar Gerencia/Dirección --</option>
                        @if (ViewBag.Direcciones != null)
                        {
                            foreach (var dir in (List<SIGCAP_TSC.Models.Catalogos.DireccionViewModel>)ViewBag.Direcciones)
                            {
                                <option value="@dir.CodDireccion">@dir.Descripcion</option>
                            }
                        }
                    </select>
                </div>

                <!-- Departamento / Dependencia (Cascada) -->
                <div>
                    <label asp-for="IdDepartamento" class="block text-sm font-semibold text-gray-700 mb-2">Dependencia / Departamento</label>
                    <select asp-for="IdDepartamento" id="departamento_select" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm">
                        <option value="">-- Seleccione una dirección primero --</option>
                    </select>
                </div>

                <!-- Geográfico: Departamento -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Ubicación: Departamento</label>
                    <select id="geo_departamento" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm">
                        <option value="">-- Seleccionar Departamento --</option>
                        @if (ViewBag.Departamentos != null)
                        {
                            foreach (var dept in (List<SIGCAP_TSC.Models.Geografico.GeograficoViewModel>)ViewBag.Departamentos)
                            {
                                <option value="@dept.departamento">@dept.nombre</option>
                            }
                        }
                    </select>
                </div>

                <!-- Geográfico: Municipio -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Ubicación: Municipio (Sede)</label>
                    <select id="geo_municipio" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm">
                        <option value="">-- Seleccione un departamento primero --</option>
                    </select>
                </div>

                <!-- Sede Regional actual -->
                <div class="col-span-2">
                    <div class="p-3 bg-gray-50 border border-gray-100 rounded-xl flex items-center justify-between">
                        <span class="text-xs text-gray-500 font-medium">Sede Regional Seleccionada (DEFORP):</span>
                        <span id="sede_regional_badge" class="text-xs bg-indigo-50 text-indigo-700 px-3 py-1 rounded-full font-bold border border-indigo-100">
                            @(string.IsNullOrEmpty(Model.sede_regional) ? "No especificada" : Model.sede_regional)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab Content: Academic Info -->
        <div id="tab-content-academico" class="tab-pane space-y-6 hidden">
            <div class="grid gap-6 md:grid-cols-2">
                <!-- Nivel Educativo -->
                <div>
                    <label asp-for="nivel_educativo" class="block text-sm font-semibold text-gray-700 mb-2">Nivel Educativo</label>
                    <select asp-for="nivel_educativo" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm">
                        <option value="">-- Seleccionar --</option>
                        <option value="Secundaria Completa">Secundaria Completa</option>
                        <option value="Pasante Universitario">Pasante Universitario</option>
                        <option value="Universitario Completo">Universitario Completo</option>
                        <option value="Postgrado / Maestría">Postgrado / Maestría</option>
                        <option value="Doctorado">Doctorado</option>
                    </select>
                </div>

                <!-- Título Obtenido -->
                <div>
                    <label asp-for="titulo_obtenido" class="block text-sm font-semibold text-gray-700 mb-2">Título Obtenido</label>
                    <input asp-for="titulo_obtenido" class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:ring-2 focus:ring-indigo-600 focus:border-indigo-600 outline-none transition-all text-sm" placeholder="Ej. Lic. en Administración Pública" maxlength="150" />
                </div>
            </div>
        </div>

        <!-- Footer buttons -->
        <div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-between">
            <div class="flex gap-2">
                <button type="button" id="prev-tab-btn" onclick="prevTab()" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-500 hover:bg-gray-100 transition-colors hidden">
                    Anterior
                </button>
            </div>
            <div class="flex items-center gap-3">
                <a href="@Url.Action("Index", "Participantes")" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-100 transition-colors">
                    Cancelar
                </a>
                <button type="button" id="next-tab-btn" onclick="nextTab()" class="px-5 py-2.5 rounded-xl text-sm font-semibold bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition-all">
                    Siguiente
                </button>
                <button type="submit" id="save-btn" class="px-5 py-2.5 rounded-xl text-sm font-semibold bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm shadow-indigo-200 transition-all flex items-center gap-2 hidden">
                    <i data-lucide="save" class="h-4 w-4"></i>
                    Guardar Participante
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    // Tab switching state
    const tabs = ['personal', 'institucional', 'academico'];
    let currentTabIndex = 0;

    function switchTab(tabId) {
        currentTabIndex = tabs.indexOf(tabId);
        
        // Update tab buttons
        tabs.forEach(tab => {
            const btn = document.getElementById(`tab-btn-${tab}`);
            const content = document.getElementById(`tab-content-${tab}`);
            
            if (tab === tabId) {
                btn.className = "border-indigo-500 text-indigo-600 whitespace-nowrap py-4 px-1 border-b-2 font-semibold text-sm transition-all focus:outline-none flex items-center gap-2";
                content.classList.remove('hidden');
            } else {
                btn.className = "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-semibold text-sm transition-all focus:outline-none flex items-center gap-2";
                content.classList.add('hidden');
            }
        });

        // Update footer buttons
        const prevBtn = document.getElementById('prev-tab-btn');
        const nextBtn = document.getElementById('next-tab-btn');
        const saveBtn = document.getElementById('save-btn');

        if (currentTabIndex === 0) {
            prevBtn.classList.add('hidden');
        } else {
            prevBtn.classList.remove('hidden');
        }

        if (currentTabIndex === tabs.length - 1) {
            nextBtn.classList.add('hidden');
            saveBtn.classList.remove('hidden');
        } else {
            nextBtn.classList.remove('hidden');
            saveBtn.classList.add('hidden');
        }
    }

    function nextTab() {
        if (currentTabIndex < tabs.length - 1) {
            switchTab(tabs[currentTabIndex + 1]);
        }
    }

    function prevTab() {
        if (currentTabIndex > 0) {
            switchTab(tabs[currentTabIndex - 1]);
        }
    }

    // Cascading Selectors: Direccion -> Departamentos
    // Serialize Gerencias from ViewBag
    const allGerencias = @Html.Raw(Json.Serialize(ViewBag.Gerencias ?? new List<SIGCAP_TSC.Models.Catalogos.DepartamentoViewModel>()));
    const initialDepartamentoId = @(Model.IdDepartamento.HasValue ? Model.IdDepartamento.Value.ToString() : "null");
    const initialDireccionId = @(Model.idDireccion.HasValue ? Model.idDireccion.Value.ToString() : "null");

    const direccionSelect = document.getElementById('direccion_select');
    const departamentoSelect = document.getElementById('departamento_select');

    function populateDepartamentos(direccionId, selectedDeptId = null) {
        departamentoSelect.innerHTML = '<option value="">-- Seleccionar Departamento --</option>';
        if (!direccionId) {
            departamentoSelect.innerHTML = '<option value="">-- Seleccione una dirección primero --</option>';
            return;
        }

        // Filter gerencias where Dependencia is equal to selected direction ID
        const filtered = allGerencias.filter(g => g.Dependencia === parseInt(direccionId));
        
        if (filtered.length === 0) {
            departamentoSelect.innerHTML = '<option value="">-- No hay departamentos vinculados --</option>';
            return;
        }

        filtered.forEach(g => {
            const opt = document.createElement('option');
            opt.value = g.CodigoDireccion;
            opt.textContent = g.DescripcionDireccion;
            if (selectedDeptId && parseInt(g.CodigoDireccion) === parseInt(selectedDeptId)) {
                opt.selected = true;
            }
            departamentoSelect.appendChild(opt);
        });
    }

    direccionSelect.addEventListener('change', function() {
        populateDepartamentos(this.value);
    });

    // Cascading Selectors: Geográfico (Departamento -> Municipios)
    const geoDeptSelect = document.getElementById('geo_departamento');
    const geoMunSelect = document.getElementById('geo_municipio');
    const sedeHidden = document.getElementById('sede_regional_hidden');
    const sedeBadge = document.getElementById('sede_regional_badge');

    geoDeptSelect.addEventListener('change', async function() {
        const deptId = this.value;
        geoMunSelect.innerHTML = '<option value="">-- Cargando municipios... --</option>';
        
        if (!deptId) {
            geoMunSelect.innerHTML = '<option value="">-- Seleccione un departamento primero --</option>';
            return;
        }

        try {
            const response = await fetch(`@Url.Action("GetMunicipios", "Participantes")?departamentoId=${deptId}`);
            if (response.ok) {
                const municipios = await response.json();
                geoMunSelect.innerHTML = '<option value="">-- Seleccionar Municipio --</option>';
                
                municipios.forEach(m => {
                    const opt = document.createElement('option');
                    opt.value = m.nombre; // We store the name in the value to easily bind to sede_regional
                    opt.textContent = m.nombre;
                    // Check if matches existing sede_regional
                    if (sedeHidden.value && m.nombre.trim().toUpperCase() === sedeHidden.value.trim().toUpperCase()) {
                        opt.selected = true;
                    }
                    geoMunSelect.appendChild(opt);
                });
            } else {
                geoMunSelect.innerHTML = '<option value="">-- Error al cargar municipios --</option>';
            }
        } catch (err) {
            console.error('Error fetching municipios:', err);
            geoMunSelect.innerHTML = '<option value="">-- Error al cargar municipios --</option>';
        }
    });

    geoMunSelect.addEventListener('change', function() {
        if (this.value) {
            sedeHidden.value = this.value;
            sedeBadge.textContent = this.value;
        }
    });

    // Initialization on page load
    document.addEventListener('DOMContentLoaded', () => {
        // Init tabs
        switchTab('personal');

        // Init Directions Cascade
        if (initialDireccionId) {
            direccionSelect.value = initialDireccionId;
            populateDepartamentos(initialDireccionId, initialDepartamentoId);
        }

        // Try to pre-select Department in Geográfico based on Sede Regional
        const currentSede = '@Html.Raw(Model.sede_regional ?? "")';
        if (currentSede) {
            sedeHidden.value = currentSede;
        }
    });
</script>
